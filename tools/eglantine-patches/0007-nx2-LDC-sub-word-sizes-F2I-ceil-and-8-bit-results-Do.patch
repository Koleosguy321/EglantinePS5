From 41e29e80dbd86b18b831aab39aaae05d736ff107 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 12:57:58 +1100
Subject: [PATCH 7/7] nx2: LDC sub-word sizes; F2I ceil and 8-bit results
 (Donkey Kong Bananza)

---
 .../frontend/ampere/lower_to_maxwell.h        | 26 ++++++++++++++++---
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
index 9c1d1e47d3..2b13d5e0b9 100644
--- a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
+++ b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
@@ -757,9 +757,9 @@ inline LoweredProgram LowerToMaxwell(std::span<const Instruction> code, bool geo
                  (u64{(high_result ? high : low) + 216} << 8) | (u64{insn.words[1]} << 20));
             break;
         }
-        case 0xb82: { // LDC.64 indexed byte offset
+        case 0xb82: { // LDC (U8, S8, U16, S16, 32, 64 as Maxwell's) indexed byte offset
             const u32 width = insn.Bits(73, 3);
-            if ((width != 4 && width != 5) || insn.Bits(78, 2) || insn.Bits(91, 1) ||
+            if (width > 5 || insn.Bits(78, 2) || insn.Bits(91, 1) ||
                 bank() >= 18 ||
                 (width == 5 && ((dest & 1) || dest >= 254))) return fail(index, "native indexed constant load mode");
             emit(base(0xef90000000000000ULL) | (u64{insn.Bits(24, 8)} << 8) |
@@ -1366,7 +1366,13 @@ inline LoweredProgram LowerToMaxwell(std::span<const Instruction> code, bool geo
             const bool small = mode == 0x00212800;
             const bool floor = (mode & ~0x10100U) == 0x00207000;
             const bool nearest = (mode & ~0x10100U) == 0x00203000;
-            if ((!half && !small && !floor && !nearest && (mode & ~0x100U) != 0x0021f000) ||
+            // Bits 75-76 the result size as Maxwell's (0 = 8 bits, 2 = 32), 78-79 the rounding as
+            // Maxwell's (2 = ceil, 3 = trunc). Donkey Kong Bananza: F2I.U32.F32.CEIL in a compute
+            // shader and F2I.FTZ.TRUNC.S8.F32 in a graphics shader.
+            const bool ceil = (mode & ~0x10100U) == 0x0020b000;
+            const bool byte = (mode & ~0x10100U) == 0x0020e000;
+            if ((!half && !small && !floor && !nearest && !ceil && !byte &&
+                 (mode & ~0x100U) != 0x0021f000) ||
                 (opcode != 0xb05 && (insn.words[1] & (half ? 0xefffff00U : 0xffffff00U))) ||
                 (opcode == 0xd05 && uniform_register(insn.Bits(32, 8)) == ~0U)) {
                 return fail(index, "native float-to-integer conversion mode");
@@ -1397,11 +1403,23 @@ inline LoweredProgram LowerToMaxwell(std::span<const Instruction> code, bool geo
             }
             emit(base(0x5cb0000000000000ULL) | (u64{small ? 1U : 2U} << 8) | (u64{2} << 10) |
                  (u64{is_signed} << 12) | (u64{source} << 20) |
-                 (u64{small || nearest ? 0U : floor ? 1U : 3U} << 39) | (u64{insn.Bits(80, 1)} << 44));
+                 (u64{small || nearest ? 0U : floor ? 1U : ceil ? 2U : 3U} << 39) | (u64{insn.Bits(80, 1)} << 44));
             if (!is_signed && !small) {
                 emit(base(0x5c40000000000000ULL) | (dest << 8) | (u64{251} << 20) |
                      (u64{1} << 41) | (u64{7} << 48));
             }
+            if (byte) {
+                // Maxwell's F2I has no 8-bit result: convert to 32 bits, then saturate as the
+                // console does (IMNMX: PT selects the minimum, !PT the maximum).
+                mov_imm(252, is_signed ? 127U : 255U);
+                emit(base(0x5c20000000000000ULL) | (dest << 8) | (u64{252} << 20) |
+                     (u64{7} << 39) | (u64{is_signed} << 48));
+                if (is_signed) {
+                    mov_imm(252, 0xffffff80U);
+                    emit(base(0x5c20000000000000ULL) | (dest << 8) | (u64{252} << 20) |
+                         (u64{7} << 39) | (u64{1} << 42) | (u64{1} << 48));
+                }
+            }
             break;
         }
         case 0xb6f: { // TXQ texture dimensions, two packed scalar outputs.
-- 
